# --- Server
PORT=3000
# Signs session tokens AND encrypts stored API keys: long (32+ characters), random, stable.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-at-least
# Public URL of the app, used in magic links. In dev, the Vite server.
PUBLIC_URL=http://localhost:5173

# --- Database (matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=collector
DB_USER=collector
DB_PASSWORD=collector

# --- SMTP (matches Mailpit in docker-compose.yml, UI at http://localhost:8025)
# Port 465 uses implicit TLS, any other port uses STARTTLS when available.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=collector
SMTP_PASSWORD=collector
SMTP_FROM="Collector <collector@localhost>"

# --- Optional
# UPLOAD_DIR=./uploads
