<!--
  Sign-in email (MJML). Placeholders like %%NAME%% are filled by server/lib/mailer.ts (values are HTML-escaped).
  Neon look: dark grey card, glowing logo and code. Web font + text-shadow show in Apple Mail;
  other clients fall back to a clean sans-serif without glow.
-->
<mjml>
  <mj-head>
    <mj-title>Collector</mj-title>
    <mj-preview>%%PREVIEW%%</mj-preview>
    <mj-font name="Tilt Neon" href="https://fonts.googleapis.com/css2?family=Tilt+Neon&amp;display=swap" />
    <mj-attributes>
      <mj-all font-family="-apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text color="#a0a0a8" font-size="15px" line-height="1.6" padding="0 28px" />
    </mj-attributes>
    <mj-style inline="inline">
      .neon { font-family: 'Tilt Neon', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #f1e6fa; }
    </mj-style>
    <mj-style>
      .glow { text-shadow: 0 0 2px #b26ee0, 0 0 10px rgba(178, 110, 224, 0.75), 0 0 24px rgba(124, 58, 173, 0.6); }
      .card { border: 1px solid #2a2a2f; border-radius: 14px; }
      @media (max-width: 480px) { .code div { font-size: 30px !important; letter-spacing: 6px !important; } }
    </mj-style>
  </mj-head>

  <mj-body background-color="#111113" width="480px">
    <!-- Brand -->
    <mj-section padding="40px 0 18px">
      <mj-group>
        <mj-column width="30%" vertical-align="middle">
          <mj-image src="cid:collector-logo" alt="" width="44px" align="right" padding="0 10px 0 0" />
        </mj-column>
        <mj-column width="70%" vertical-align="middle">
          <mj-text padding="0" font-size="30px" line-height="1.1" align="left" css-class="neon glow">
            <span class="neon glow" style="font-family: 'Tilt Neon', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #f1e6fa;">Collector</span>
          </mj-text>
        </mj-column>
      </mj-group>
    </mj-section>

    <!-- Card -->
    <mj-wrapper padding="0 16px">
      <mj-section background-color="#1b1b1e" border-radius="14px" css-class="card" padding="28px 0 24px">
        <mj-column>
          <mj-text color="#ececee" font-size="17px" font-weight="600" padding="0 28px 6px">%%HELLO%%</mj-text>
          <mj-text padding="0 28px 22px">%%BODY%%</mj-text>
          <mj-button
            href="%%LINK%%" background-color="#b26ee0" color="#ffffff" font-size="15px" font-weight="600"
            border-radius="10px" inner-padding="13px 26px" padding="0 28px 26px"
          >%%CTA%%</mj-button>

          <mj-divider border-color="#2a2a2f" border-width="1px" padding="0 28px 22px" />

          <mj-text align="center" font-size="13px" color="#6b6b74" padding="0 28px 8px">%%CODE_LABEL%%</mj-text>
          <mj-text align="center" padding="0 28px 8px" css-class="code">
            <div class="neon glow" style="font-family: 'Tilt Neon', ui-monospace, 'SF Mono', Menlo, Consolas, monospace; color: #f1e6fa; font-size: 36px; letter-spacing: 10px; line-height: 1.2;">%%CODE%%</div>
          </mj-text>
          <mj-text align="center" font-size="12px" color="#6b6b74" padding="0 28px">%%EXPIRES%%</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- Footer -->
    <mj-section padding="20px 0 40px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#55555e">%%IGNORE%%</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
