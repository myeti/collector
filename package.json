{
    "name": "collector",
    "version": "0.0.1",
    "type": "module",
    "dependencies": {
        "@ai-sdk/anthropic": "^4.0.107",
        "@ai-sdk/google": "^4.0.123",
        "@ai-sdk/mistral": "^4.0.89",
        "@ai-sdk/openai": "^4.0.122",
        "@ai-sdk/openai-compatible": "^3.0.94",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource/tilt-neon": "^5.3.0",
        "@zxing/browser": "^0.2.1",
        "@zxing/library": "^0.23.0",
        "ai": "^7.0.178",
        "cookie-parser": "^1.4.7",
        "express": "^5.3.0",
        "feather-icons": "^4.29.2",
        "mjml": "^5.4.1",
        "multer": "^2.5.0",
        "nodemailer": "^10.6.1",
        "pg": "^8.23.1",
        "pg-hstore": "^2.3.4",
        "sequelize": "^6.37.8",
        "sharp": "^0.35.5",
        "undici": "^8.13.0",
        "vue": "^3.5.46",
        "vue-feather": "^2.0.0",
        "vue-i18n": "^11.4.23",
        "vue-router": "^5.5.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/multer": "^2.3.0",
        "@types/node": "^26.6.6",
        "@types/nodemailer": "^8.0.2",
        "@vitejs/plugin-basic-ssl": "^2.3.0",
        "@vitejs/plugin-vue": "^6.0.11",
        "concurrently": "^10.0.7",
        "typescript": "^7.0.2",
        "vite": "^8.3.8"
    },
    "scripts": {
        "dev": "concurrently -k -n api,app -c magenta,cyan \"npm:dev:api\" \"npm:dev:app\"",
        "dev:https": "DEV_HTTPS=1 concurrently -k -n api,app -c magenta,cyan \"npm:dev:api\" \"node server/scripts/dev-https.ts\"",
        "dev:api": "node --env-file-if-exists=.env --watch server/main.ts",
        "dev:app": "vite",
        "build": "vite build",
        "start": "NODE_ENV=production node --env-file-if-exists=.env server/main.ts",
        "create:user": "node --env-file-if-exists=.env server/scripts/create-user.ts",
        "db:sync": "node --env-file-if-exists=.env server/scripts/db-sync.ts",
        "typecheck": "tsc --noEmit -p .",
        "icons": "node server/scripts/icons.ts",
        "bump": "node server/scripts/bump.ts"
    },
    "engines": {
        "node": ">=23.6"
    },
    "overrides": {
        "uuid": "^11.1.1",
        "minimatch": "^11.0.1",
        "glob": "^14.0.6"
    }
}
